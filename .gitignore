# 发布/工具产物（本地使用，不入库）
.tools/

# 汉化引擎运行时状态（每个项目一份，不该跟着仓库走）
.hanhua-*
*.bak

# 自带的第三方依赖（iconv-lite/safer-buffer）：只保留运行需要的文件
preset/plugins/hanhua/node_modules/*/.idea/
preset/plugins/hanhua/node_modules/*/.github/
preset/plugins/hanhua/node_modules/*/tests.js

# 测试运行时产物（可随时重新生成）
tests/.work*/
tests/.verify/work*/
tests/.verify/work-*/
tests/.verify/ocrwork/
tests/.verify/iconv-probe/
__pycache__/
*.pyc
